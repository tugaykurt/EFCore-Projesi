@model KursKayit
@{
    ViewData["Title"] = "Edit";
}
<h2>Kurs Kayıt Güncelleme</h2>
<hr />
<form asp-controller="KursKayit" asp-action="Edit" method="post">
    <input type="hidden" asp-for="@Model.KayitId" />
    <input type="hidden" asp-for="@Model.KayitTarihi" />
    <div class="mb-3">
        <label asp-for="OgrenciId" class="form-label">Öğrenci</label>
        <input asp-for="@Model.Ogrenci.AdSoyad" class="form-control" disabled />
        <input type="hidden" asp-for="@Model.OgrenciId" />
    </div>
    <div class="mb-3">
        <label asp-for="KursId" class="form-label">Kurs</label>
        <select asp-for="KursId" asp-items="@ViewBag.Kurslar"  class="form-select" >
        </select>
    </div>
    <button type="submit" class="btn btn-secondary">Kaydet</button>
</form>

