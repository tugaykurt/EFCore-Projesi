@model KursKayit
@{
    ViewData["Title"] = "Delete";
}
<p>
    <b>@Model.Ogrenci.AdSoyad</b> isimli öğrencinin kurs kaydını silmek istiyor musunuz?
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="@Model.KayitId" />
        <button type="submit" class="btn btn-danger">Evet</button>
        <a asp-action="Index" class="btn btn-primary">Hayır</a>
    </form>
</p>

