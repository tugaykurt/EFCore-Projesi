@model Ogretmen
@{
    ViewData["Title"] = "Create";
}
<h2>Ogretmen Ekle</h2>
<hr />
<form asp-controller="Ogretmen" asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Ad" class="form-label">Öğretmen Ad</label>
        <input asp-for="Ad" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Soyad" class="form-label">Öğretmen Soyad</label>
        <input asp-for="Soyad" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Eposta</label>
        <input asp-for="Email" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Telefon" class="form-label">Telefon</label>
        <input asp-for="Telefon" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="BaslamaTarihi" class="form-label">İşe Başlama Tarihi</label>
        <input asp-for="BaslamaTarihi" class="form-control" />
    </div>
    <button type="submit" class="btn btn-secondary">Kaydet</button>
</form>

